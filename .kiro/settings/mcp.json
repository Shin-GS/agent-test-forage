      "command": "npx",
      "args": [
        "ai-playbook-mcp"
      ],
      "env": {
        "PLAYBOOK_API_URL": "https://playbook.cloudrudtjq1213.com",
        "PLAYBOOK_API_KEY": "sk-abcdef",
        "NODE_TLS_REJECT_UNAUTHORIZED": "0"
      },
      "autoApprove": [
        "list_catalog",
