# ai-test-forge server 환경변수 템플릿
# 실제 값을 채워 .env 로 복사한 뒤 사용 (.env 는 git 에 커밋하지 않음)
# Spring Boot 실행 시 환경변수로 주입 (예: dotenv 플러그인 또는 OS 환경변수)

# ── 서버 ──
SERVER_PORT=8080

# ── DB (MySQL) ──
DB_URL=jdbc:mysql://localhost:3306/ai_test_forge
DB_USERNAME=root
DB_PASSWORD=changeme

# ── AI (OpenAI 호환: OpenAI / OpenRouter 등) ──
# base-url + api-key만 바꾸면 프로바이더 전환 (둘 다 OpenAI 호환 API).
# api-key가 비어 있으면 실제 AI 대신 규칙 기반 목이 동작한다.
# ⚠️ 모델은 반드시 tool calling(function calling)을 지원하는 것을 사용할 것.
#    우리 의도 분석은 tool_choice=required로 tool 선택을 강제하므로, 미지원 모델은
#    400 에러가 나거나 tool을 안 골라 clarify로 빠진다. gpt-4o 계열은 지원 확인됨.
# OpenRouter 예시:
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxx
AI_MODEL_REASONING=openai/gpt-4o
AI_MODEL_FAST=openai/gpt-4o-mini
# OpenAI 직접 사용 시:
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# AI_MODEL_REASONING=gpt-4o
# AI_MODEL_FAST=gpt-4o-mini
AI_HISTORY_LIMIT=15
AI_TIMEOUT_SECONDS=30

# ── Jira (정보 조회 커넥터) ──
# 인스턴스 baseUrl + API 토큰은 서버 시크릿. projectKey 는 서비스별로 스펙에서 관리.
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_API_TOKEN=your-jira-api-token
